# Configuration Production — Backend Cantale
# Copier ce fichier en .env et adapter les valeurs

NODE_ENV=production
PORT=3001

# ============================================================
# BASE DE DONNÉES
# ============================================================
# Le backend doit partager la même DB que le plugin Minecraft.

# Option 1: SQLite (simple, fichier local)
DB_TYPE=sqlite
DB_PATH=./cantale.db

# Option 2: MySQL (si le serveur Minecraft utilise MySQL)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cantale_user
# DB_PASSWORD=CHANGE_ME
# DB_NAME=cantale

# ============================================================
# SESSIONS & SÉCURITÉ
# ============================================================
# Générer une chaîne aléatoire longue :
# openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
SESSION_MAX_AGE_DAYS=7

# ============================================================
# CORS
# ============================================================
# Domaine du frontend. Mettre * seulement pour les tests.
CORS_ORIGIN=https://ton-site.com

# ============================================================
# BOUTIQUE
# ============================================================
SHOP_ENABLED=false
