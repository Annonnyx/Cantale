# ────────────────────────────────────────────────────────────────
# Cantale backend — configuration
# Copier en .env et adapter les valeurs.
# ────────────────────────────────────────────────────────────────

# Port d'écoute du backend (généralement derrière nginx en reverse proxy)
PORT=3000

# Environnement : development | production
NODE_ENV=production

# ────────────────────────────────────────────────────────────────
# Base de données
# ────────────────────────────────────────────────────────────────
# Type : sqlite | mysql
#   - sqlite : utilise le fichier du plugin (lecture + écriture sur tables web_*)
#   - mysql  : recommandé en prod (le plugin doit aussi être configuré en MySQL)
DB_TYPE=sqlite

# Chemin du fichier SQLite (uniquement si DB_TYPE=sqlite)
# Doit pointer sur la même DB que le plugin Cantale
SQLITE_PATH=/home/cantale/server/plugins/CantalePlugin/cantale.db

# Connexion MySQL (uniquement si DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cantale
MYSQL_USER=cantale
MYSQL_PASSWORD=changeme

# ────────────────────────────────────────────────────────────────
# Sécurité
# ────────────────────────────────────────────────────────────────
# Secret pour signer les session tokens (32+ caractères aléatoires)
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Domaine du cookie de session (laisser vide en dev)
COOKIE_DOMAIN=

# CORS : origines autorisées (séparées par virgules)
CORS_ORIGINS=http://localhost:5500,http://localhost:8080,https://cantale.fr

# ────────────────────────────────────────────────────────────────
# Configuration métier
# ────────────────────────────────────────────────────────────────
# Durée de vie d'un code de liaison in-game (secondes)
LINK_CODE_TTL=300

# Durée d'une session (secondes) — 7 jours par défaut
SESSION_TTL=604800

# Boutique : transactions actives ?
SHOP_ENABLED=false
