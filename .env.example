# Base de données du plugin CANTALE (lecture seule côté site)
# Option A — URI (encoder le mot de passe : @ → %40, = → %3D, ^ → %5E)
# DATABASE_URL="mysql://user:pass%40word@host:3306/cantale"
# Option B — credentials discrets (préférés si le mdp contient des caractères spéciaux)
# DB_HOST="…"
# DB_PORT="3306"
# DB_USER="…"
# DB_PASSWORD="…"
# DB_NAME="…"
DATABASE_URL="mysql://user:password@host:3306/cantale"

# Application Discord (https://discord.com/developers/applications)
# OAuth2 → Redirects : {AUTH_URL}/api/auth/discord/callback
# Les DEUX variables sont obligatoires (sans SECRET → « echange_impossible » en callback).
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Bot Discord — lecture des rôles des membres de la guilde + tickets web
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Catégorie Discord pour les tickets partenariats (optionnel).
# Si vide, réutilise la catégorie support/tickets déjà utilisée par le recrutement.
# DISCORD_PARTNERSHIPS_CATEGORY_ID=""

# Cloudflare Turnstile (optionnel) — anti-robot sur recrutement & partenariats.
# Sans ces clés, seul le honeypot est actif.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Auth — secret de signature des cookies de session (générer : openssl rand -base64 32)
AUTH_SECRET=""
# Origine publique canonique du site (sans slash final), base de l'URL de callback OAuth.
# Prod : préférer https://www.cantale.world (le apex redirige vers www).
# Dev : http://localhost:3000
AUTH_URL="http://localhost:3000"

# Boutique (désactivée par défaut)
SHOP_ENABLED="false"

# Cron — secret Bearer protégeant les tâches planifiées du site
# (GET /api/cron/snapshot ; générer : openssl rand -base64 32)
CRON_SECRET=""

# Carte du monde détaillée (optionnel) — URL d'une Squaremap/BlueMap.
# Si définie, /carte charge les tuiles via proxy/Leaflet + overlays Cantale.
# En HTTP, le site proxifie via /map-provider/* (évite mixed content HTTPS→HTTP).
# Idéal long terme : HTTPS dédié (ex. map.cantale.world via reverse proxy).
# Exemple : MAP_PROVIDER_URL="http://82.66.173.236:25577"
#
# Vie privée joueurs : /carte n'affiche jamais les joueurs. Le proxy site
# remplace aussi /map-provider/tiles/players.json par un JSON vide.
# Ops Squaremap (plugins/squaremap/config.yml), recommandé :
#   world-settings.default.player-tracker.enabled: false
MAP_PROVIDER_URL=""

# Page /admin — IDs Discord autorisés (virgules si plusieurs). Jamais committer la vraie valeur.
# ADMIN_DISCORD_ID="1122092101459517481"
